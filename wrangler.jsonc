{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atencion-al-cliente",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "keep_vars": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
